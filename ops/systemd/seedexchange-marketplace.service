[Unit]
Description=Seedexchange reservation and marketplace worker
After=postgresql.service

[Service]
Type=oneshot
User=seedexchange
Group=seedexchange
WorkingDirectory=/projects/seedexchange.online/current
EnvironmentFile=/projects/seedexchange.online/shared/staging.env
ExecStart=/usr/bin/node dist/scripts/process-marketplace.js
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/projects/seedexchange.online/shared
