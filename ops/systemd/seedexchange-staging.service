[Unit]
Description=Seedexchange staging web
After=network.target postgresql.service

[Service]
Type=simple
User=seedexchange
Group=seedexchange
WorkingDirectory=/srv/seedexchange/current
EnvironmentFile=/srv/seedexchange/shared/staging.env
ExecStart=/usr/bin/node dist/src/server.js
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/seedexchange/shared

[Install]
WantedBy=multi-user.target
