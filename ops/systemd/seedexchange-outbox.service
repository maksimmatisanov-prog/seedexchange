[Unit]
Description=Seedexchange outbox delivery
After=postgresql.service

[Service]
Type=oneshot
User=seedexchange
Group=seedexchange
WorkingDirectory=/srv/seedexchange/current
EnvironmentFile=/srv/seedexchange/shared/staging.env
ExecStart=/usr/bin/node dist/scripts/send-outbox.js
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/seedexchange/shared
