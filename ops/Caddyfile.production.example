www.seedexchange.online {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
	}
	redir https://seedexchange.online{uri} permanent
}

seedexchange.online {
	encode zstd gzip
	reverse_proxy 127.0.0.1:4200 {
		health_uri /health
		health_interval 30s
		health_timeout 2s
	}
}
