{
  "name": "seedexchange",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "check": "tsc --noEmit",
    "clean": "node scripts/clean-dist.mjs",
    "build": "npm run clean && tsc && node scripts/copy-static.mjs",
    "start": "node dist/src/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "migrate": "node dist/src/db/migrate.js",
    "seed": "node dist/src/db/seed.js",
    "create-admin": "node dist/scripts/create-admin.js",
    "generate-sitemap": "node dist/scripts/generate-sitemap.js",
    "send-outbox": "node dist/scripts/send-outbox.js",
    "process-marketplace": "node dist/scripts/process-marketplace.js",
    "verify-ready": "node dist/scripts/verify-ready.js",
    "verify:discovery-data": "node dist/scripts/verify-discovery-data.js",
    "verify:discovery-rehearsal": "node dist/scripts/verify-discovery-rehearsal.js",
    "verify:production-env": "node dist/scripts/verify-production-environment.js",
    "verify:production-observation": "node dist/scripts/verify-production-observation.js",
    "verify:discovery-runtime": "node dist/scripts/verify-discovery-runtime.js",
    "manifest:release": "node dist/scripts/create-release-manifest.js",
    "verify:release": "node dist/scripts/verify-release-manifest.js",
    "verify:media": "node dist/scripts/verify-media.js",
    "backfill:media-sha": "node dist/scripts/backfill-media-sha.js",
    "manifest:media": "node dist/scripts/media-manifest.js",
    "manifest:discovery-backup": "node dist/scripts/discovery-backup-manifest.js",
    "verify:discovery-backup": "node dist/scripts/verify-discovery-backup.js",
    "sync:oreshka": "node dist/scripts/sync-oreshka.js",
    "prepare:supplier-batch": "node dist/scripts/prepare-supplier-batch.js",
    "migrate-legacy": "node dist/scripts/migrate-legacy.js"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/formbody": "^8.0.0",
    "@fastify/multipart": "^9.4.0",
    "@fastify/rate-limit": "^10.2.1",
    "@fastify/static": "^10.1.3",
    "@fastify/view": "^10.0.1",
    "bcrypt": "^6.0.0",
    "dotenv": "^16.4.7",
    "ejs": "^3.1.10",
    "fastify": "^5.3.3",
    "mysql2": "^3.24.2",
    "nodemailer": "^9.1.1",
    "pg": "^8.13.3",
    "sharp": "^0.35.4",
    "stripe": "^17.7.0",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@types/bcrypt": "^5.0.2",
    "@types/node": "^22.15.2",
    "@types/nodemailer": "^6.4.17",
    "@types/pg": "^8.11.11",
    "nodemon": "^3.1.9",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^3.2.7"
  }
}
