<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> · Seedexchange</title>
  <meta name="description" content="<%= description %>">
  <meta name="robots" content="<%= typeof robots !== 'undefined' ? robots : 'index,follow' %>">
  <% if (typeof canonical !== 'undefined' && canonical) { %>
  <link rel="canonical" href="https://seedexchange.online<%= canonical %>">
  <% } %>
  <meta name="theme-color" content="#173d2d">
  <meta property="og:site_name" content="Seedexchange">
  <meta property="og:type" content="website">
  <meta property="og:url" content="https://seedexchange.online<%= typeof canonical !== 'undefined' ? canonical : '/' %>">
  <meta property="og:title" content="<%= title %>">
  <meta property="og:description" content="<%= description %>">
  <meta property="og:image" content="<%= appUrl %>/assets/hero-botanical-archive-v3.png">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="<%= title %>">
  <meta name="twitter:description" content="<%= description %>">
  <meta name="twitter:image" content="/assets/hero-botanical-archive-v3.png">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="stylesheet" href="/assets/app.css">
  <script type="application/ld+json">
  <%- JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    'name': 'Seedexchange',
    'url': 'https://seedexchange.online'
  }) %>
  </script>
</head>
<body>
  <a href="#main" class="skip-link">Skip to content</a>
  <header class="site-header">
    <nav class="nav" aria-label="Main navigation">
      <a href="/" class="nav-brand">Seedexchange</a>
      <button class="nav-toggle" type="button" aria-controls="primary-navigation" aria-expanded="false">Menu</button>
      <ul class="nav-links" id="primary-navigation">
        <li><a href="/directory">Directory</a></li>
        <li><a href="/marketplace">Marketplace</a></li>
        <li><a href="/exchange">Exchange</a></li>
        <li><a href="/search">Search</a></li>
      </ul>
      <div class="nav-actions">
        <% if (commerceEnabled) { %>
        <a href="/cart" class="nav-cart">Cart</a>
        <% } %>
        <% if (currentUser) { %>
        <a href="/account" class="button button-small">Account</a>
        <form method="post" action="/logout" class="nav-form"><input type="hidden" name="csrf" value="<%= csrfToken %>"><button class="button button-small button-secondary">Sign out</button></form>
        <% } else { %>
        <a href="/login" class="button button-small">Sign in</a>
        <a href="/register" class="button button-small button-secondary">Register</a>
        <% } %>
      </div>
    </nav>
  </header>
  <main id="main">
    <%- body %>
  </main>
  <footer class="site-footer">
    <div class="footer-content">
      <p>A public hub for seed banks, botanic gardens, nurseries and collectors.</p>
      <ul class="footer-links">
        <li><a href="/about">About</a></li>
        <li><a href="/pricing">Pricing</a></li>
        <li><a href="/terms">Terms</a></li>
        <li><a href="/privacy">Privacy</a></li>
      </ul>
      <p class="footer-compliance">Sellers are responsible for export requirements; buyers are responsible for import requirements in their destination country.</p>
    </div>
  </footer>
  <script src="/assets/app.js" defer></script>
</body>
</html>
