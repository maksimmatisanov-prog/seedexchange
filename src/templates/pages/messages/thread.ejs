<section class="page-intro"><p class="eyebrow">Private correspondence</p><h1><%= conversation.organization_name %></h1><p><a href="/messages">All messages</a></p></section><section class="section workspace"><div class="message-thread"><% messages.forEach(function(message){ %><article class="panel"><strong><%= message.sender_email %></strong><p><%= message.body %></p><small><%= new Date(message.created_at).toLocaleString('en-GB') %></small></article><% }) %></div><form class="panel form" method="post"><input type="hidden" name="csrf" value="<%= csrfToken %>"><label>Reply<textarea name="body" minlength="2" maxlength="5000" required></textarea></label><button class="button">Send reply</button></form></section>
