<section class="page-intro"><p class="eyebrow">Private correspondence</p><h1>Messages</h1><p>Conversations between buyers and organization teams.</p></section><section class="section workspace"><% if (conversations.length) { %><div class="record-list"><% conversations.forEach(function(item){ %><a href="/messages/<%= item.id %>"><strong><%= item.organization_name %></strong><span><%= item.last_message_at ? new Date(item.last_message_at).toLocaleDateString('en-GB') : 'New conversation' %></span></a><% }) %></div><% } else { %><div class="empty-state"><h2>No conversations yet</h2><p>Open an approved organization profile to start a conversation.</p></div><% } %></section>
