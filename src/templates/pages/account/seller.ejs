<section class="page-intro"><h1><%= organization.name %></h1><p>Organization status: <%= organization.status %>. Seller status: <%= organization.seller_status %>.</p></section><section class="section workspace"><h2>Products</h2><form class="panel form" method="post" action="/seller/product"><input type="hidden" name="csrf" value="<%= csrfToken %>"><input type="hidden" name="organization_id" value="<%= organization.id %>"><label>Name<input name="name" required></label><label>SKU<input name="sku" required></label><label>Botanical name<input name="botanical_name"></label><label>Category<input name="category"></label><label>Description<textarea name="description" minlength="20" required></textarea></label><label>Price EUR<input type="number" name="price" min=".5" step=".01" required></label><label>Stock<input type="number" name="stock_quantity" min="0" value="0" required></label><label>Packet quantity<input name="packet_quantity"></label><button class="button">Submit product for review</button></form><div class="record-list"><% products.forEach(function(item){ %><div><strong><%= item.name %></strong><span><%= item.status %></span></div><% }) %></div>
<h2>Shipping zones</h2><form class="panel form" method="post" action="/seller/shipping"><input type="hidden" name="csrf" value="<%= csrfToken %>"><input type="hidden" name="organization_id" value="<%= organization.id %>"><label>Name<input name="name" required></label><label>Country codes<input name="countries" placeholder="PL,DE,FR" required></label><label>Rate EUR<input type="number" name="rate" min="0" step=".01" required></label><button class="button">Add shipping zone</button></form>
<h2>Exchange and donations</h2><form class="panel form" method="post" action="/seller/exchange"><input type="hidden" name="csrf" value="<%= csrfToken %>"><input type="hidden" name="organization_id" value="<%= organization.id %>"><label>Mode<select name="mode"><option value="exchange">Exchange</option><option value="donate">Donate</option></select></label><label>Title<input name="title" required></label><label>Species<input name="species"></label><label>Quantity<input name="quantity_available"></label><label>Description<textarea name="description" minlength="20" required></textarea></label><button class="button">Publish listing</button></form></section>
