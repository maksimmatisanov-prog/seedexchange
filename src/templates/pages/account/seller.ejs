<section class="page-intro">
  <h1><%= organization.name %></h1>
  <p>Organization status: <%= organization.status %>.</p>
  <% if (!commerceEnabled) { %><p>Discovery launch: public profile, contact channels, seed exchange and donation listings are available. Internal sales, shipping and order processing remain disabled.</p><% } %>
</section>

<section class="section workspace" id="profile">
  <h2>Public profile</h2>
  <form class="panel form" method="post" action="/seller/organization/<%= organization.id %>/profile">
    <input type="hidden" name="csrf" value="<%= csrfToken %>">
    <label>Name<input name="name" value="<%= organization.name %>" required maxlength="190"></label>
    <label>Country<input name="country" value="<%= organization.country %>" required maxlength="100"></label>
    <label>Two-letter country code<input name="country_code" value="<%= organization.country_code || '' %>" pattern="[A-Za-z]{2}" maxlength="2"></label>
    <label>Region<input name="region" value="<%= organization.region || '' %>" maxlength="190"></label>
    <label>Description<textarea name="description" minlength="30" maxlength="5000" required><%= organization.description %></textarea></label>
    <label>Specialties<textarea name="specialties" maxlength="5000"><%= organization.specialties || '' %></textarea></label>
    <label>Public contact URL<input type="url" name="contact_url" value="<%= organization.contact_url || '' %>" maxlength="500"></label>
    <label>Website URL<input type="url" name="website_url" value="<%= organization.website_url || '' %>" maxlength="500"></label>
    <button class="button">Save profile</button>
  </form>
</section>

<section class="section workspace" id="channels">
  <h2>Public contact channels</h2>
  <p>Only official HTTPS profile links are accepted. Email is stored as a public mail link.</p>
  <form class="panel form" method="post" action="/seller/organization/<%= organization.id %>/channels">
    <input type="hidden" name="csrf" value="<%= csrfToken %>">
    <% Object.entries(organizationChannelLabels).forEach(function(entry){ const type=entry[0], label=entry[1]; %>
      <label><%= label %><input <%= type === 'email' ? 'type="email"' : 'type="url"' %> name="channel_<%= type %>" value="<%= channels[type] || '' %>" maxlength="1000"></label>
    <% }) %>
    <button class="button">Save contact channels</button>
  </form>
</section>

<section class="section workspace" id="exchange">
  <h2>Exchange and donations</h2>
  <form class="panel form" method="post" action="/seller/exchange">
    <input type="hidden" name="csrf" value="<%= csrfToken %>"><input type="hidden" name="organization_id" value="<%= organization.id %>">
    <label>Mode<select name="mode"><option value="exchange">Exchange</option><option value="donate">Donate</option></select></label>
    <label>Title<input name="title" required maxlength="255"></label><label>Species<input name="species" required maxlength="255"></label><label>Variety<input name="variety" maxlength="255"></label><label>Category<input name="category" maxlength="100"></label><label>Origin country<input name="origin_country" maxlength="100"></label><label>Quantity available<input name="quantity_available" required maxlength="120"></label><label>What you want in exchange<textarea name="wants" maxlength="2000"></textarea></label><label>Public contact URL<input type="url" name="contact_url" value="<%= organization.contact_url || '' %>" maxlength="500" required></label><label>Description<textarea name="description" minlength="20" maxlength="5000" required></textarea></label>
    <button class="button">Publish listing</button>
  </form>
  <% if (exchanges.length) { %><div class="record-list"><% exchanges.forEach(function(item){ %><article><h3><%= item.title %></h3><p>Status: <strong><%= item.status %></strong>. Mode: <%= item.mode %>.</p><% if (item.status === 'active') { %><form method="post" action="/seller/exchange/<%= item.id %>/complete"><input type="hidden" name="csrf" value="<%= csrfToken %>"><button>Mark completed</button></form><form method="post" action="/seller/exchange/<%= item.id %>/withdraw"><input type="hidden" name="csrf" value="<%= csrfToken %>"><button>Withdraw</button></form><% } %></article><% }) %></div><% } else { %><p>No exchange or donation listings yet.</p><% } %>
</section>

<% if (commerceEnabled) { %>
<section class="section workspace">
  <h2>Marketplace products</h2><form class="panel form" method="post" action="/seller/product"><input type="hidden" name="csrf" value="<%= csrfToken %>"><input type="hidden" name="organization_id" value="<%= organization.id %>"><label>Name<input name="name" required></label><label>SKU<input name="sku" required></label><label>Botanical name<input name="botanical_name"></label><label>Category<input name="category"></label><label>Description<textarea name="description" minlength="20" required></textarea></label><label>Price EUR<input type="number" name="price" min=".5" step=".01" required></label><label>Stock<input type="number" name="stock_quantity" min="0" value="0" required></label><label>Packet quantity<input name="packet_quantity"></label><button class="button">Submit product for review</button></form><div class="record-list"><% products.forEach(function(item){ %><div><strong><%= item.name %></strong><span><%= item.status %></span></div><% }) %></div>
  <h2>Shipping zones</h2><form class="panel form" method="post" action="/seller/shipping"><input type="hidden" name="csrf" value="<%= csrfToken %>"><input type="hidden" name="organization_id" value="<%= organization.id %>"><label>Name<input name="name" required></label><label>Country codes<input name="countries" placeholder="PL,DE,FR" required></label><label>Rate EUR<input type="number" name="rate" min="0" step=".01" required></label><button class="button">Add shipping zone</button></form>
  <h2>Seller orders</h2><% if (orders.length) { %><div class="record-list"><% orders.forEach(function(order){ %><article><h3>Seller order #<%= order.id %></h3><p>Status: <strong><%= order.status %></strong>. Transfer: <%= order.transfer_status %>.</p><% if (order.tracking_number) { %><p><%= order.carrier %>: <%= order.tracking_number %></p><% } %><% if (order.status === 'paid') { %><form method="post" action="/seller/order/<%= order.id %>/processing"><input type="hidden" name="csrf" value="<%= csrfToken %>"><button>Start processing</button></form><% } %><% if (order.status === 'paid' || order.status === 'processing') { %><form class="form" method="post" action="/seller/order/<%= order.id %>/ship"><input type="hidden" name="csrf" value="<%= csrfToken %>"><label>Carrier<input name="carrier" required maxlength="120"></label><label>Tracking number<input name="tracking_number" required maxlength="190"></label><label>Tracking URL<input type="url" name="tracking_url" maxlength="500"></label><button class="button">Mark as shipped</button></form><% } %></article><% }) %></div><% } else { %><p>No seller orders yet.</p><% } %>
</section>
<% } %>
