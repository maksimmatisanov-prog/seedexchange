<section class="page-intro"><p class="eyebrow">Purchase record</p><h1>Order #<%= order.id %></h1><p>Status: <strong><%= order.status %></strong>. Total: <strong><%= new Intl.NumberFormat('en-US',{style:'currency',currency:order.currency}).format(Number(order.total_cents)/100) %></strong>.</p></section><section class="section workspace"><h2>Items</h2><div class="record-list"><% items.forEach(function(item){ %><div><strong><%= item.name %> × <%= item.quantity %></strong><span><%= new Intl.NumberFormat('en-US',{style:'currency',currency:order.currency}).format(Number(item.unit_price_cents)*item.quantity/100) %></span></div><% }) %></div><h2>Seller fulfilment</h2><div class="record-list"><% sellerOrders.forEach(function(item){ %><article><h3><%= item.organization_name %></h3><p>Status: <strong><%= item.status %></strong><% if (item.tracking_number) { %> / <%= item.carrier %>: <%= item.tracking_number %><% } %></p><% if (item.tracking_url) { %><p><a href="<%= item.tracking_url %>" rel="noopener">Track shipment</a></p><% } %><% if (item.has_open_case) { %><p class="form-error" role="status">A delivery case is open.</p><% } %><% if (item.status === 'shipped' && !item.has_open_case) { %><form method="post" action="/account/orders/<%= order.id %>/seller/<%= item.id %>/confirm-delivery"><input type="hidden" name="csrf" value="<%= csrfToken %>"><button class="button">Confirm delivery</button></form><% } %><% if ((item.status === 'shipped' || item.status === 'delivered') && !item.has_open_case) { %><form class="form" method="post" action="/account/orders/<%= order.id %>/seller/<%= item.id %>/delivery-case"><input type="hidden" name="csrf" value="<%= csrfToken %>"><label>Issue<select name="reason"><option value="not_received">Not received</option><option value="damaged">Damaged</option><option value="wrong_item">Wrong item</option><option value="other">Other</option></select></label><label>Details<textarea name="details" minlength="20" maxlength="5000" required></textarea></label><button>Open delivery case</button></form><% } %></article><% }) %></div><a href="/account">Back to account</a></section>
