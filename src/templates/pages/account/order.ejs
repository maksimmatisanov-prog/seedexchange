<section class="page-intro"><p class="eyebrow">Purchase record</p><h1>Order #<%= order.id %></h1><p>Status: <strong><%= order.status %></strong>. Total: <strong><%= new Intl.NumberFormat('en-US',{style:'currency',currency:order.currency}).format(Number(order.total_cents)/100) %></strong>.</p></section><section class="section workspace"><h2>Items</h2><div class="record-list"><% items.forEach(function(item){ %><div><strong><%= item.name %> × <%= item.quantity %></strong><span><%= new Intl.NumberFormat('en-US',{style:'currency',currency:order.currency}).format(Number(item.unit_price_cents)*item.quantity/100) %></span></div><% }) %></div><h2>Seller fulfilment</h2><div class="record-list"><% sellerOrders.forEach(function(item){ %><div><strong><%= item.organization_name %></strong><span><%= item.status %><% if (item.tracking_number) { %> / <%= item.tracking_number %><% } %></span></div><% }) %></div><a href="/account">Back to account</a></section>
