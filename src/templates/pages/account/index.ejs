<section class="page-intro"><h1>Your account</h1><p><%= currentUser.email %><% if (!currentUser.emailVerifiedAt) { %> / email verification pending<% } %></p></section><section class="section workspace"><h2>Organizations</h2><% if (organizations.length) { %><div class="record-list"><% organizations.forEach(function(item){ %><a href="/seller/organization/<%= item.id %>"><strong><%= item.name %></strong><span><%= item.status %></span></a><% }) %></div><% } else { %><div class="empty-state"><h3>No organization yet</h3><p>Organization applications become available after email verification.</p></div><% } %><% if (currentUser.emailVerifiedAt) { %><form class="panel form" method="post" action="/organization/submit"><h3>Submit an organization</h3><input type="hidden" name="csrf" value="<%= csrfToken %>"><label>Type<select name="type"><option value="seed_bank">Seed bank</option><option value="botanic_garden">Botanic garden</option><option value="nursery">Nursery</option><option value="shop">Shop</option><option value="grower">Grower</option><option value="collector">Collector</option></select></label><label>Name<input name="name" required maxlength="190"></label><label>Country<input name="country" required maxlength="100"></label><label>Website<input type="url" name="website_url"></label><label>Description<textarea name="description" minlength="30" maxlength="5000" required></textarea></label><button class="button">Submit for review</button></form><% } %><h2>Orders</h2><% if (orders.length) { %><div class="record-list"><% orders.forEach(function(order){ %><a href="/account/orders/<%= order.id %>"><strong>Order #<%= order.id %></strong><span><%= order.status %></span></a><% }) %></div><% } else { %><p>No orders yet.</p><% } %></section>
