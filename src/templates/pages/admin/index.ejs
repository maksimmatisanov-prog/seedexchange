<section class="page-intro"><h1>Platform administration</h1><p>Moderation queues and protected operations.</p></section><section class="section workspace"><h2>Organizations awaiting review</h2><div class="record-list"><% organizations.forEach(function(item){ %><article><h3><%= item.name %></h3><p><%= item.description %></p><div class="inline-actions"><% ['approve','info-request','reject'].forEach(function(action){ %><form method="post" action="/admin/organization/<%= item.id %>/<%= action %>"><input type="hidden" name="csrf" value="<%= csrfToken %>"><button><%= action %></button></form><% }) %></div></article><% }) %></div><h2>Products awaiting review</h2><div class="record-list"><% products.forEach(function(item){ %><article><h3><%= item.name %></h3><p><%= item.organization_name %>. <%= item.description %></p><div class="inline-actions"><% ['approve','reject'].forEach(function(action){ %><form method="post" action="/admin/product/<%= item.id %>/<%= action %>"><input type="hidden" name="csrf" value="<%= csrfToken %>"><button><%= action %></button></form><% }) %></div></article><% }) %></div><h2>Supplier batches</h2><p><%= batches.length %> pending batches</p><h2>Delivery cases</h2><p><%= cases.length %> open cases</p><h2>Reports</h2><p><%= reports.length %> open reports</p></section>
