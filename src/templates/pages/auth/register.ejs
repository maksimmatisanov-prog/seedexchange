<section class="form-page"><div><h1>Create an account</h1><p>Start as a buyer, then submit an organization for review.</p></div><form class="panel form" method="post"><input type="hidden" name="csrf" value="<%= csrfToken %>"><% if (error) { %><p class="form-error" role="alert"><%= error %></p><% } %><label>Email<input type="email" name="email" autocomplete="email" required></label><label>Password<span>At least 10 characters</span><input type="password" name="password" autocomplete="new-password" minlength="10" required></label><button class="button">Create account</button></form></section>
