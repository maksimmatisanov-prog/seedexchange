<section class="form-page"><div><h1>Choose a new password</h1><p>Use at least ten characters.</p></div><form class="panel form" method="post"><input type="hidden" name="csrf" value="<%= csrfToken %>"><input type="hidden" name="token" value="<%= token %>"><% if (error) { %><p class="form-error" role="alert"><%= error %></p><% } %><label>New password<input type="password" name="password" minlength="10" autocomplete="new-password" required></label><button class="button">Update password</button></form></section>
