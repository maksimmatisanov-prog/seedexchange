<section class="form-page"><div><h1>Sign in</h1><p>Access orders, messages and organization workspaces.</p></div><form class="panel form" method="post"><input type="hidden" name="csrf" value="<%= csrfToken %>"><% if (error) { %><p class="form-error" role="alert"><%= error %></p><% } %><label>Email<input type="email" name="email" autocomplete="email" required></label><label>Password<input type="password" name="password" autocomplete="current-password" required></label><button class="button">Sign in</button><p><a href="/forgot-password">Forgot your password?</a></p></form></section>
