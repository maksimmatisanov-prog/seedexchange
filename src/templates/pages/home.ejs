<section class="home-hero">
  <div class="hero-copy">
    <p class="eyebrow">The living seed archive</p>
    <h1 id="home-title">Seeds are stories worth keeping alive.</h1>
    <p>Find documented seeds, trusted collections and the people preserving plant diversity across borders.</p>
    <a class="button" href="/marketplace">Explore the marketplace</a>
  </div>
</section>

<section class="section archive-paths">
  <header class="editorial-heading">
    <p class="eyebrow">Three ways to take part</p>
    <h2>A public record built around living collections</h2>
  </header>
  <div class="archive-list">
    <a class="archive-row" href="/directory">
      <span class="archive-number">01</span>
      <span><strong>Find custodians</strong><small>Browse approved seed banks, botanic gardens, nurseries and collectors.</small></span>
      <span class="archive-link">Open directory</span>
    </a>
    <a class="archive-row" href="/exchange">
      <span class="archive-number">02</span>
      <span><strong>Exchange responsibly</strong><small>Contact collection owners directly about no-money exchanges and donations.</small></span>
      <span class="archive-link">View exchange</span>
    </a>
    <a class="archive-row" href="/marketplace">
      <span class="archive-number">03</span>
      <span><strong>Order from growers</strong><small>Buy available seeds from approved sellers with seller-specific shipping and protected checkout.</small></span>
      <span class="archive-link">Visit marketplace</span>
    </a>
  </div>
</section>

<section class="archive-metrics" aria-label="Archive totals">
  <div>
    <strong><%= stats.organizations %></strong>
    <span>approved organizations</span>
  </div>
  <div>
    <strong><%= stats.products %></strong>
    <span>marketplace accessions</span>
  </div>
  <div>
    <strong><%= stats.exchanges %></strong>
    <span>active exchanges</span>
  </div>
</section>

<section class="section founder-callout">
  <div>
    <p class="eyebrow">Founding Organizations · first 50 approvals</p>
    <h2>Help shape the network from its first season.</h2>
    <p>The first 50 approved organizations receive a permanent public Founder badge. Approved sellers also receive a 7% marketplace commission for 12 months from first activation, then their standard rate applies.</p>
  </div>
  <a class="button" href="/register">Register an organization</a>
</section>
