<nav class="breadcrumbs section" aria-label="Breadcrumb"><a href="/marketplace">Marketplace</a><span>/</span><span><%= product.name %></span></nav>
<section class="product-detail"><div class="product-detail-image"><img src="<%= product.image_url || '/assets/seed-placeholder.svg' %>" alt="<%= product.name %>" width="900" height="700"></div><div class="product-detail-copy"><p><%= product.category || 'Seeds' %> from <a href="/directory/<%= product.organization_slug %>"><%= product.organization_name %></a></p><h1><%= product.name %></h1><% if (product.botanical_name) { %><p class="botanical-name"><em><%= product.botanical_name %></em></p><% } %><p><%= product.description %></p><strong class="detail-price"><%= new Intl.NumberFormat('en-US',{style:'currency',currency:product.currency}).format(Number(product.price_cents)/100) %></strong><% if (product.purchase_mode === 'external') { %><a class="button" href="<%= product.external_purchase_url %>" rel="noopener">View at source</a><% } else { %><form method="post" action="/cart/add"><input type="hidden" name="csrf" value="<%= csrfToken %>"><input type="hidden" name="product_id" value="<%= product.id %>"><button class="button" <%= Number(product.stock_quantity)<1?'disabled':'' %>><%= Number(product.stock_quantity)>0?'Add to cart':'Unavailable' %></button></form><% } %></div></section>
