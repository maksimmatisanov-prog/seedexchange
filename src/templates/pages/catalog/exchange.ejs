<section class="page-intro"><h1><%= title %></h1><p><%= description %></p></section><section class="section"><p class="result-bar"><%= exchanges.length %> active listings</p><% if (exchanges.length) { %><div class="exchange-grid"><% exchanges.forEach(function(item){ %><article><p><%= item.mode %> from <a href="/directory/<%= item.organization_slug %>"><%= item.organization_name %></a></p><h2><%= item.title %></h2><% if (item.species) { %><p><em><%= item.species %></em></p><% } %><p><%= item.description %></p><small><%= item.quantity_available || 'Contact the custodian for availability' %></small></article><% }) %></div><% } else { %><div class="empty-state"><h2>No active exchanges</h2><p>Approved organizations can publish exchange and donation listings.</p></div><% } %></section>
