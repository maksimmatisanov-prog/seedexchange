<% if (organization.cover_key) { %><section class="organization-cover"><img src="/media/<%= organization.cover_key %>" alt="<%= organization.name %> collection cover" width="1200" height="600"></section><% } %>
<section class="profile-hero"><div><% if (organization.logo_key) { %><img class="organization-profile-logo" src="/media/<%= organization.logo_key %>" alt="<%= organization.name %> logo" width="160" height="160"><% } %><p><%= organization.type.replaceAll('_',' ') %> in <%= organization.country %><% if (organization.region) { %>, <%= organization.region %><% } %></p><h1><%= organization.name %></h1><p><%= organization.description %></p><% if (organization.specialties) { %><p><strong>Specialties:</strong> <%= organization.specialties %></p><% } %><% if (organization.website_url) { %><a class="button" href="<%= organization.website_url %>" rel="noopener">Visit website</a><% } %></div><dl><div><dt>Products</dt><dd><%= organization.product_count %></dd></div><% if (organization.founder_slot) { %><div><dt>Founder</dt><dd>#<%= organization.founder_slot %></dd></div><% } %></dl></section>
<% if (organization.channels.length || organization.contact_url) { %><section class="section"><h2>Public contacts</h2><ul><% if (organization.contact_url) { %><li><a href="<%= organization.contact_url %>" rel="noopener">Primary contact</a></li><% } %><% organization.channels.forEach(function(channel){ %><li><a href="<%= channel.url %>" rel="noopener"><%= channel.label %><%= channel.is_verified ? ' · verified' : '' %></a></li><% }) %></ul></section><% } %>
<% if (organization.exchanges.length) { %><section class="section"><h2>Exchange and donation listings</h2><div class="exchange-grid"><% organization.exchanges.forEach(function(item){ %><article><p><%= item.mode %></p><h3><%= item.title %></h3><% if (item.species) { %><p><em><%= item.species %><%= item.variety ? ' · ' + item.variety : '' %></em></p><% } %><p><%= item.description %></p><% if (item.quantity_available) { %><small><%= item.quantity_available %></small><% } %><% if (item.contact_url) { %><p><a class="button button-small" href="<%= item.contact_url %>" rel="noopener">Contact custodian</a></p><% } %></article><% }) %></div></section><% } %>
<% if (organization.products.length) { %><section class="section"><h2>Available seeds</h2><div class="product-grid"><% organization.products.forEach(function(product){ %><%- include('../../partials/product-card', { product: product }) %><% }) %></div></section><% } %>
<% if (currentUser && currentUser.emailVerifiedAt) { %><section class="section"><form class="panel form" method="post" action="/messages/start"><h2>Contact this organization</h2><input type="hidden" name="csrf" value="<%= csrfToken %>"><input type="hidden" name="organization_id" value="<%= organization.id %>"><label>Message<textarea name="body" minlength="2" maxlength="5000" required></textarea></label><button class="button">Start conversation</button></form></section><% } %>
