<section class="page-intro"><h1><%= title %></h1><p><%= description %></p></section>
<section class="section"><form class="filter-panel" method="get" action="/marketplace"><label>Search<input type="search" name="q" value="<%= filters.q || '' %>"></label><label>Category<input name="category" value="<%= filters.category || '' %>"></label><button class="button">Apply filters</button></form>
<p class="result-bar"><%= products.length %> accessions</p><% if (products.length) { %><div class="product-grid"><% products.forEach(function(product){ %><%- include('../../partials/product-card', { product: product }) %><% }) %></div><% } else { %><div class="empty-state"><h2>No accessions match this view</h2><p>Try a broader search or return after the first reviewed catalog import.</p></div><% } %></section>
