<section class="page-intro"><h1>Search the archive</h1><form class="search-form" action="/search"><label>Species, accession or SKU<input type="search" name="q" value="<%= q %>" required></label><button class="button">Search</button></form></section>
<section class="section"><% if (q) { %><p class="result-bar"><%= products.length %> results for “<%= q %>”</p><div class="product-grid"><% products.forEach(function(product){ %><%- include('../../partials/product-card', { product: product }) %><% }) %></div><% } else { %><div class="empty-state"><h2>Start with a botanical name or SKU</h2><p>Search uses the reviewed public catalog only.</p></div><% } %></section>
