<section class="page-intro"><h1>Your cart</h1><p>Prices, stock and shipping are verified again before checkout.</p></section><section class="section"><% if (lines.length) { %><div class="record-list"><% lines.forEach(function(line){ %><div class="cart-line"><span><strong><%= line.name %></strong><small><%= line.organization_name %> / quantity <%= line.quantity %></small></span><strong><%= new Intl.NumberFormat('en-US',{style:'currency',currency:line.currency}).format(Number(line.price_cents)*line.quantity/100) %></strong><form method="post" action="/cart/remove"><input type="hidden" name="csrf" value="<%= csrfToken %>"><input type="hidden" name="product_id" value="<%= line.id %>"><button>Remove</button></form></div><% }) %></div><p class="cart-total">Subtotal <strong><%= new Intl.NumberFormat('en-US',{style:'currency',currency:lines[0].currency}).format(subtotal/100) %></strong></p><form class="panel form checkout-form" method="post" action="/checkout/create"><input type="hidden" name="csrf" value="<%= csrfToken %>"><label>Email<input type="email" name="email" value="<%= currentUser?.email || '' %>" required></label><label>Destination country code<input name="country" minlength="2" maxlength="2" placeholder="PL" required></label><button class="button">Continue to secure checkout</button><p>Checkout remains unavailable until Stripe test acceptance and an explicit enablement decision.</p></form><% } else { %><div class="empty-state"><h2>Your cart is empty</h2><p>Browse reviewed marketplace accessions to begin.</p><a class="button" href="/marketplace">Open marketplace</a></div><% } %></section>
